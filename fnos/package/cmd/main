#!/bin/bash
# fnOS invokes start/stop/status. Install and upgrade callbacks only prepare files.
set -u

BASE="/var/apps/${TRIM_APPNAME:-fusionplay-fnos}"
APP="${TRIM_APPDEST:-$BASE/target}"
VAR="${TRIM_PKGVAR:-$BASE/var}"
PKGHOME="${TRIM_PKGHOME:-$BASE/home}"
PORT="${TRIM_SERVICE_PORT:-18080}"
BIN="$APP/bin/fusionplay-fnos"
WWW="$APP/www"
LOG="$VAR/app.log"
PID_FILE="$VAR/app.pid"
SOCK="$APP/fusionplay-fnos.sock"
export HOME="$PKGHOME" DATA_LIBRARY_PATH="${DATA_LIBRARY_PATH:-$VAR}"
export TRIM_SERVICE_PORT="$PORT" GATEWAY_SOCKET="$SOCK" GATEWAY_PREFIX="/app/fusionplay-fnos"
unset CI

# ---------------- 日志上限（tail-trim，原地重写） ----------------
# ★ 必须原地重写，不能 mv/rename：子进程的 stdout/stderr、shell 的 >> 都持有同一个 inode，
#   rename 之后它们继续写进「已改名的旧文件」——表面有轮转，实际在丢日志。
# ★ 默认值写在函数体内部：测试会从本脚本 sed 提取该函数单独跑，默认值放外面会一起丢。
trim_log() {
    local file="$1" size tmp max keep
    max="${LOG_MAX_BYTES:-5242880}"      # 5 MiB
    keep="${LOG_KEEP_BYTES:-1048576}"    # 1 MiB
    [ -f "$file" ] || return 0
    size="$(stat -c %s "$file" 2>/dev/null || echo 0)"
    case "$size" in ''|*[!0-9]*) return 0 ;; esac
    [ "$size" -le "$max" ] && return 0
    tmp="$file.rotate.tmp"
    if tail -c "$keep" "$file" > "$tmp.raw" 2>/dev/null; then
        awk 'NR>1' "$tmp.raw" > "$tmp" 2>/dev/null    # 丢掉被切半的首行
        if cat "$tmp" > "$file" 2>/dev/null; then      # 原地重写（不是 mv）
            echo "$(date '+%Y-%m-%d %H:%M:%S') - [logrotate] 日志超过 $((max / 1048576))MiB，已保留尾部 $((keep / 1024))KiB" >> "$file" 2>/dev/null
        fi
    fi
    rm -f "$tmp" "$tmp.raw" 2>/dev/null
    return 0
}
log() { echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "$LOG" 2>/dev/null; trim_log "$LOG"; }

fail() {
    local msg="FusionPlay：$1"
    log "$msg" || true
    printf '%s\n' "$msg" >&2
    if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then printf '%s\n' "$msg" > "$TRIM_TEMP_LOGFILE"; fi
    return 1
}

prepare() {
    mkdir -p "$VAR" "$PKGHOME" && [ -w "$VAR" ] && [ -w "$PKGHOME" ] ||
        { fail "应用账户无法写入 $VAR 或 $PKGHOME，请检查应用存储权限。"; return 1; }
    if [ -f "$BIN" ] && [ ! -x "$BIN" ]; then chmod +x "$BIN" 2>/dev/null || true; fi
    local actual
    if ! actual=$("$BIN" --version 2>&1); then
        fail "后台程序无法执行，请检查 FPK 架构、运行库和执行权限。$actual"
        return 1
    fi
    # Read the *installed payload* version. TRIM_APPVER can refer to a
    # different phase of an upgrade.
    local expected
    expected=$(sed -n 's/^version=//p' "$APP/BUILD-INFO") &&
        [ -n "$expected" ] && [ "$actual" = "$expected" ] ||
        { fail "安装文件版本不一致，后台为 $actual，包记录为 ${expected:-缺失}。"; return 1; }
}

pid_of() {
    local pid
    [ -f "$PID_FILE" ] && IFS= read -r pid < "$PID_FILE" && [[ "$pid" =~ ^[1-9][0-9]*$ ]] &&
        printf '%s' "$pid"
}
# Compare the kernel's executable identity. argv can contain this path as
# an unrelated argument; a PID can also have been recycled since shutdown.
bin_path=$(readlink -f -- "$BIN")
owns_pid() {
    local pid="$1" exe
    [[ "$pid" =~ ^[1-9][0-9]*$ ]] || return 1
    exe=$(readlink "/proc/$pid/exe" 2>/dev/null) || return 1
    [[ "${exe% (deleted)}" == "$bin_path" ]]
}
our_pids() {
    local pid
    while read -r pid; do
        if owns_pid "$pid"; then printf '%s\n' "$pid"; fi
    done < <(pgrep -x fusionplay-fnos || true)
}
is_running() {
    local pid
    pid=$(pid_of) && owns_pid "$pid" && [ "/proc/$pid/exe" -ef "$BIN" ] &&
        curl --noproxy '*' -fsS --max-time 2 --unix-socket "$SOCK" http://localhost/healthz >/dev/null 2>&1 &&
        curl --noproxy '*' -fsS --max-time 2 "http://127.0.0.1:$PORT/healthz" >/dev/null 2>&1
}
port_busy() {
    command -v ss >/dev/null && [ -n "$(ss -H -lnt "sport = :$PORT" 2>/dev/null)" ]
}
stop() {
    local pid i
    local -a pids
    mapfile -t pids < <(our_pids)
    for pid in "${pids[@]}"; do
        if owns_pid "$pid"; then kill -TERM "$pid" 2>/dev/null || true; fi
    done
    for ((i=0; i<40; i++)); do
        local alive=false
        for pid in "${pids[@]}"; do if owns_pid "$pid"; then alive=true; break; fi; done
        if ! "$alive"; then break; fi
        sleep 0.2
    done
    # Rescan to include any speaker worker launched just before shutdown.
    mapfile -t pids < <(our_pids)
    for pid in "${pids[@]}"; do
        if owns_pid "$pid"; then kill -KILL "$pid" 2>/dev/null || true; fi
    done
    for ((i=0; i<20; i++)); do
        [ -z "$(our_pids)" ] && break
        sleep 0.1
    done
    if [ -n "$(our_pids)" ]; then fail "旧服务仍在运行，无法停止。请查看 $LOG。"; return 1; fi
    rm -f -- "$PID_FILE" "$SOCK" || { fail "无法清理应用的 PID 或网关 Socket。"; return 1; }
}
start() {
    is_running && return 0
    prepare || return 1
    [ -w "$APP" ] || { fail "应用账户无法在 $APP 创建网关 Socket。请检查应用目录权限。"; return 1; }
    stop || return 1
    if port_busy; then fail "端口 $PORT 已被其他服务占用，请释放端口后重新启用。"; return 1; fi
    log "starting port=$PORT home=$HOME var=$VAR"
    nohup "$BIN" --config "$PKGHOME/config.json" --state-dir "$VAR" --www "$WWW" \
        --listen-tcp "127.0.0.1:$PORT" --listen-unix "$SOCK" </dev/null >>"$LOG" 2>&1 9>&- &
    local pid=$! i
    if ! printf '%s\n' "$pid" > "$PID_FILE"; then
        stop; fail "无法保存 PID 到 $PID_FILE。"; return 1
    fi
    for ((i=0; i<80; i++)); do
        if is_running; then log "started pid=$pid"; return 0; fi
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.25
    done
    stop || return 1
    fail "后台未能启动，请查看 $LOG 中的启动错误。"
}

case "${1:-}" in
    prepare) prepare; exit $? ;;
    status) if is_running; then exit 0; else exit 3; fi ;;
    start|stop|restart) ;;
    *) exit 1 ;;
esac
mkdir -p "$VAR" && { exec 9>>"$VAR/lifecycle.lock"; } &&
    flock -w 45 9 || { fail "无法取得服务启停锁 $VAR/lifecycle.lock。"; exit 1; }
case "$1" in
    start) start ;;
    stop) stop ;;
    restart) stop && start ;;
esac
